{
	"name": "@webitel/quality-auditor",
	"version": "26.8.0",
	"private": true,
	"scripts": {
		"dev": "vite --force",
		"build": "vite build",
		"preview": "npm run build && vite preview --base /audit",
		"lint:fix": "npx biome check --write ./src",
		"lint:fix-staged": "npx lint-staged",
		"test:unit": "vitest run --passWithNoTests",
		"utils:i": "npm install --install-links",
		"utils:link-libs": "npm link @webitel/ui-sdk @webitel/api-services @webitel/ui-datalist && npm run utils:ls-libs",
		"utils:ls-libs": "npm ls @webitel/ui-sdk @webitel/api-services @webitel/ui-datalist",
		"utils:up-libs": "npm update @webitel/ui-sdk @webitel/api-services @webitel/ui-datalist && npm ls @webitel/ui-sdk @webitel/api-services @webitel/ui-datalist",
		"prepare": "husky",
		"biome:ci:gh": "biome ci ./src --reporter=github",
		"test:unit:ci": "vitest run --coverage --passWithNoTests",
		"typecheck": "vue-tsc --noEmit -p ./tsconfig.json",
		"typecheck:ci": "npm run typecheck"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/vue": "^1.1.6",
		"@morev/vue-transitions": "^3.0.5",
		"@regle/schemas": "^1.x",
		"@vue/compat": "^3.5.x",
		"@vuelidate/core": "^2.0.3",
		"@vuelidate/validators": "^2.0.4",
		"@vueuse/core": "^14.0",
		"@webitel/api-services": "^1.0.11",
		"@webitel/styleguide": "~26.2.19",
		"@webitel/ui-datalist": "^1.1.82",
		"@webitel/ui-sdk": "~26.8.69",
		"axios": "^1.18.1",
		"clipboard-copy": "^4.0.1",
		"deep-equal": "^2.x",
		"deepmerge": "^4.x",
		"lodash-es": "^4.x",
		"pinia": "^3.x",
		"vue": "^3.5.x",
		"vue-i18n": "^11.x",
		"vue-router": "^4.x",
		"vuex": "^4.1.0",
		"webitel-sdk": "^26.4.25",
		"zod": "^4.x"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@vitejs/plugin-vue": "^6.x",
		"@vitest/coverage-v8": "^4.x",
		"@vue/test-utils": "^2.x",
		"globals": "^17.x",
		"happy-dom": "^20.11.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.x",
		"sass": "^1.102.0",
		"tslib": "^2.8.1",
		"typescript": "5.9.x",
		"vite": "^8.x",
		"vite-plugin-node-polyfills": "^0.x",
		"vite-plugin-vue-devtools": "^8.x",
		"vitest": "^4.x",
		"vue-tsc": "^3.3.8"
	},
	"optionalDependencies": {
		"@esbuild/darwin-arm64": "^0.28.1",
		"@rollup/rollup-linux-x64-gnu": "^4"
	}
}
